# Copy to .env and change every "change-me" value.

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=egsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=egsa_ai
DATABASE_URL=postgresql+psycopg://egsa:change-me@db:5432/egsa_ai

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
# true when served over HTTPS (refresh cookie gets the Secure flag)
COOKIE_SECURE=false

# ── Storage ───────────────────────────────────────────────
STORAGE_ROOT=/data/storage
MAX_UPLOAD_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt

# ── AI (backend only, never exposed to the frontend) ──────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=

# ── Seed ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@egsa.local
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO=true

# ── Frontend / CORS ───────────────────────────────────────
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=http://localhost:5173

# ── Docker host port ──────────────────────────────────────
HTTP_PORT=80
