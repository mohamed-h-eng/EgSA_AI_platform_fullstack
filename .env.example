# Copy to .env and change every "change-me" value.

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=egsa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=egsa_ai
DATABASE_URL=postgresql+psycopg://egsa:change-me@db:5432/egsa_ai

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_HOURS=8
# true when served over HTTPS (refresh cookie gets the Secure flag)
COOKIE_SECURE=false

# ── Storage ───────────────────────────────────────────────
STORAGE_ROOT=/data/storage
MAX_UPLOAD_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt

# ── AI ────────────────────────────────────────────────────
# The OpenRouter connection (API key, base URL, models) is entered by an admin in
# Admin Settings → AI model and stored encrypted in the database.
# Optional: dedicated key for encrypting stored secrets (derived from JWT_SECRET if empty).
APP_ENCRYPTION_KEY=

# ── Seed ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@egsa.local
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO=true
# Password shared by the FAKE demo accounts (ahmed.lead@, mohamed.eng@, sara.viewer@,
# hussein.sar@egsa.local). Leave empty to skip creating them. Never use in production.
SEED_DEMO_PASSWORD=change-me-demo

# ── Frontend / CORS ───────────────────────────────────────
VITE_API_BASE_URL=/api/v1
CORS_ORIGINS=http://localhost:5173

# ── Docker host port ──────────────────────────────────────
HTTP_PORT=80
